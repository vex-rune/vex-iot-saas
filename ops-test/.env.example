# 测试环境默认配置 (复制为 .env 后修改, 或直接在 docker compose 命令行覆盖)
# 用法: cp .env.example .env && docker compose --env-file .env up -d

# PostgreSQL
PG_DB=iot_saas_test
PG_USER=postgres
PG_PASSWORD=testpass

# EMQX Dashboard
EMQX_DASHBOARD_PASSWORD=public

# service 应用配置 (在 IDE 启动 service 时, 用以下环境变量覆盖默认值)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/iot_saas_test
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=testpass
# REDIS_HOST=localhost
# MQTT_BROKER=tcp://localhost:1883
# MQTT_USER=iot
# MQTT_PASSWORD=iot