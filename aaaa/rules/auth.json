  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "summary" : "登录",
        "description" : "登录",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "required" : [ "challenge", "loginType", "signature", "username" ],
                "type" : "object",
                "properties" : {
                  "username" : {
                    "type" : "string",
                    "description" : "用户名"
                  },
                  "loginType" : {
                    "type" : "string",
                    "description" : "{ADMIN=管理员动态码登录（用户名=admin + 6 位 TOTP 动态码）, USER=普通用户账密登录（用户名 + 密码）}",
                    "enum" : [ "ADMIN", "USER" ]
                  },
                  "challenge" : {
                    "type" : "string",
                    "description" : "USER 类型=密码明文；ADMIN 类型=任意占位（后端忽略）"
                  },
                  "signature" : {
                    "type" : "string",
                    "description" : "ADMIN 类型=动态码；USER 类型=任意占位（后端忽略）"
                  }
                },
                "description" : "登录请求"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "登录响应（包含业务令牌和刷新令牌）",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "properties" : {
                    "code" : {
                      "type" : "string",
                      "description" : ""
                    },
                    "message" : {
                      "type" : "string",
                      "description" : ""
                    },
                    "data" : {
                      "type" : "object",
                      "properties" : {
                        "accessToken" : {
                          "type" : "string",
                          "description" : ""
                        },
                        "refreshToken" : {
                          "type" : "string",
                          "description" : ""
                        },
                        "accessExpiresIn" : {
                          "type" : "integer",
                          "description" : "",
                          "format" : "int64"
                        },
                        "refreshExpiresIn" : {
                          "type" : "integer",
                          "description" : "",
                          "format" : "int64"
                        }
                      },
                      "description" : ""
                    }
                  },
                  "description" : "登录响应（包含业务令牌和刷新令牌）"
                }
              }
            }
          }
        }
      }
    },
